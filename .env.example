# Copy to .env (git-ignored) and fill in PAPER keys from https://app.alpaca.markets  (Paper Trading -> API keys).
# Never commit .env, never paste keys into notebook cells or strategy.py.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Optional: data feed for the free plan is iex (default). Do not use sip unless your plan includes it.
QSW_DATA_FEED=iex
# Optional: map the five fictional workshop assets to real instruments (liquid ETFs by default).
QSW_SYMBOL_MAP=AURA:SPY,BOLT:QQQ,CRUX:IWM,DUNE:DIA,ECHO:XLK
